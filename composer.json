{
    "name": "phpbrew/phpbrew",
    "description": "PHPBrew API library",
    "license": "MIT",
    "authors": [
        {
            "name": "c9s",
            "email": "cornelius.howl@gmail.com"
        },
        {
            "name": "Márcio Almada",
            "email": "marcio3w@gmail.com",
            "homepage": "https://github.com/marcioAlmada/"
        }
    ],
    "config" : {
        "platform": {
            "php": "8.1.0"
        },
        "platform-check": false
    },
    "bin": [
        "bin/phpbrew"
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/PPP01/CLIFramework"
        },
        {
            "type": "vcs",
            "url": "https://github.com/PPP01/CurlKit"
        }
    ],
    "require": {
        "php": "^7.4 || ^8.0",
        "corneltek/pearx": "^1.3.5",
        "corneltek/curlkit": "dev-master#a509e80",
        "ext-simplexml": "*",
        "symfony/yaml": "^5.4",
        "corneltek/cliframework": "3.0.x-dev#6324540"
    },
    "require-dev": {
        "php-vcr/php-vcr": "^1.8.2",
        "phpunit/phpunit": "^10.5"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "2.0.x-dev"
        }
    },
    "autoload": {
        "psr-4": {
            "PhpBrew\\": "src/PhpBrew/"
        }
    }
}
